{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/data/**",
              "components/media/**",
              "components/slide/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fredoka|Montserrat))/i]",
        "message": "Font not provided by the design system. Available: Fredoka, Montserrat."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssessmentPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|art|children|panelWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<AssessmentPanel> doesn't accept that prop. Declared props: label, title, art, children, panelWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AwardStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<AwardStrip> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brush'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|corner|rotate|flip|style|key|ref|className|style|children)$/]",
        "message": "<Brush> doesn't accept that prop. Declared props: width, corner, rotate, flip, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brush'] > JSXAttribute[name.name='corner'] > Literal[value!=/^(?:bottom-right|bottom-left|top-right|top-left)$/]",
        "message": "<Brush> corner must be one of 'bottom-right' | 'bottom-left' | 'top-right' | 'top-left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|key|ref|className|style|children)$/]",
        "message": "<CheckListItem> doesn't accept that prop. Declared props: title, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkillTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|color|key|ref|className|style|children)$/]",
        "message": "<SkillTag> doesn't accept that prop. Declared props: label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|headColors|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, headColors, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DividerSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|kicker|brush|inset|style|key|ref|className|style|children)$/]",
        "message": "<DividerSlide> doesn't accept that prop. Declared props: children, color, kicker, brush, inset, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonutStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|color|size|thickness|style|key|ref|className|style|children)$/]",
        "message": "<DonutStat> doesn't accept that prop. Declared props: value, label, color, size, thickness, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|size|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, color, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighlightText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|style|key|ref|className|style|children)$/]",
        "message": "<HighlightText> doesn't accept that prop. Declared props: children, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|color|size|glyphScale|style|key|ref|className|style|children)$/]",
        "message": "<IconCircle> doesn't accept that prop. Declared props: icon, color, size, glyphScale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|gap|tilliOnly|style|key|ref|className|style|children)$/]",
        "message": "<LogoLockup> doesn't accept that prop. Declared props: height, gap, tilliOnly, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutlineCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|color|title|children|footer|width|iconSize|align|style|key|ref|className|style|children)$/]",
        "message": "<OutlineCard> doesn't accept that prop. Declared props: icon, color, title, children, footer, width, iconSize, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutlineCard'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<OutlineCard> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|width|height|radius|fit|style|key|ref|className|style|children)$/]",
        "message": "<PhotoFrame> doesn't accept that prop. Declared props: src, alt, width, height, radius, fit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:cover|contain)$/]",
        "message": "<PhotoFrame> fit must be one of 'cover' | 'contain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|variant|size|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: children, color, variant, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|tint|solid)$/]",
        "message": "<Pill> variant must be one of 'outline' | 'tint' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|note|price|unit|features|featured|width|style|key|ref|className|style|children)$/]",
        "message": "<PriceCard> doesn't accept that prop. Declared props: name, note, price, unit, features, featured, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|color|width|style|key|ref|className|style|children)$/]",
        "message": "<QuoteCard> doesn't accept that prop. Declared props: children, attribution, color, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:green|cyan|pink|yellow)$/]",
        "message": "<QuoteCard> color must be one of 'green' | 'cyan' | 'pink' | 'yellow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rail'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|style|key|ref|className|style|children)$/]",
        "message": "<Rail> doesn't accept that prop. Declared props: variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rail'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:content|cover)$/]",
        "message": "<Rail> variant must be one of 'content' | 'cover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|subtitle|lead|color|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, subtitle, lead, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|background|rail|pad|scale|style|key|ref|className|style|children)$/]",
        "message": "<SlideFrame> doesn't accept that prop. Declared props: children, background, rail, pad, scale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|color|weight|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<SlideTitle> doesn't accept that prop. Declared props: children, size, color, weight, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|children|color|size|tint|width|style|key|ref|className|style|children)$/]",
        "message": "<StatChip> doesn't accept that prop. Declared props: value, children, color, size, tint, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatChip'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:pink|green|cyan|yellow|orange|grey)$/]",
        "message": "<StatChip> color must be one of 'pink' | 'green' | 'cyan' | 'yellow' | 'orange' | 'grey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|children|footer|icon|color|width|style|key|ref|className|style|children)$/]",
        "message": "<StepCard> doesn't accept that prop. Declared props: number, title, children, footer, icon, color, width, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
